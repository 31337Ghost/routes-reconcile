MT_HOST=192.168.88.1
MT_USER=routebot
MT_PASS=CHANGE_ME_LONG
MT_USE_SSL=true
MT_SSL_VERIFY=false
MT_PORT=8729
MT_WG_GW=wg0
MT_DOMAINS=api.openai.com,chat.openai.com,auth.openai.com,platform.openai.com,chatgpt.com,ios.chat.openai.com
# Extra DNS resolvers queried in addition to the system one (union of answers).
#MT_RESOLVERS=8.8.8.8,1.1.1.1
# Client subnets for Google DoH EDNS Client Subnet queries; RU networks by default,
# so region-specific endpoints (8.6.112.x, 8.47.69.x) are discovered too.
#MT_ECS_SUBNETS=77.88.8.0/24,178.176.0.0/24,85.26.128.0/24,31.173.0.0/24,213.59.0.0/24
# Route the announced BGP prefix (e.g. 8.6.112.0/24) instead of per-IP /32,
# because DNS rotates addresses inside the prefix. Set false to keep /32 routes.
#MT_EXPAND_PREFIXES=true
# Never expand to prefixes broader than this length (protects from huge shared ranges).
#MT_EXPAND_MIN_PREFIXLEN=24
MT_DRY_RUN=true
